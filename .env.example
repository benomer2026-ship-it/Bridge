# Add these in your cloud host's secret/environment settings.
# Never commit a real API key or paste it into ChatGPT.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
# Generate a long random token separate from the Anthropic key.
MCP_ACCESS_TOKEN=replace_with_a_long_random_access_token
ANTHROPIC_VERSION=2026-10-21
